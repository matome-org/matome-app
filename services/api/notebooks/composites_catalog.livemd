## Detail panel — assembled MatomeDetailPanel

```elixir
panel_item = fn ico, title, meta, sync_state ->
  m = if meta == "", do: "", else: ~s(<div class="matome-panel-row__meta">#{meta}</div>)
  """
  <div class="matome-panel-row">
    <span class="matome-panel-row__icon">#{icon.(ico, "")}</span>
    <div class="matome-panel-row__body"><div class="matome-panel-row__title">#{title}</div>#{m}</div>
    #{sync.(sync_state)}
  </div>
  """
end

panel = fn filed ->
  space =
    if filed do
      ~s(<div class="matome-detail-panel__space">#{icon.("folder", "")}<span class="matome-detail-panel__space-name">Marketing</span><button class="matome-btn matome-btn--text">Refile</button></div>)
    else
      ~s(<div class="matome-detail-panel__space"><button class="matome-panel-add">#{icon.("folder", "matome-panel-add__icon")}<span>File into space</span></button></div>)
    end

  """
  <div class="matome-detail-panel" style="max-width:420px;border:1px solid var(--matome-border);border-radius:var(--matome-radius-lg)">
    <div class="matome-detail-panel__header"><span class="matome-detail-panel__title">Client X — weekly</span><button class="matome-icon-btn" aria-label="Close">#{icon.("close", "")}</button></div>

    <section class="matome-panel-section">
      <div class="matome-panel-section__head"><span class="matome-panel-section__label">Items · 2</span></div>
      <div class="matome-panel-section__body">
        #{panel_item.("mic", "Meeting audio", "12:04", "cloud")}
        #{panel_item.("image", "Whiteboard", "", "on_device")}
        <button class="matome-panel-add">#{icon.("add", "matome-panel-add__icon")}<span>Add item</span></button>
      </div>
      <hr class="matome-panel-section__divider">
    </section>

    <section class="matome-panel-section">
      <div class="matome-panel-section__head"><span class="matome-panel-section__label">People · 1</span></div>
      <div class="matome-panel-section__body">
        <div class="matome-panel-row"><span class="matome-avatar matome-avatar--sm">A</span><div class="matome-panel-row__body"><div class="matome-panel-row__title">Ana</div><div class="matome-panel-row__meta">Organizer</div></div></div>
        <button class="matome-panel-add">#{icon.("person_add", "matome-panel-add__icon")}<span>Add person</span></button>
      </div>
      <hr class="matome-panel-section__divider">
    </section>

    <section class="matome-panel-section">
      <div class="matome-panel-section__head"><span class="matome-panel-section__label">Space</span></div>
      <div class="matome-panel-section__body">#{space}</div>
      <hr class="matome-panel-section__divider">
    </section>

    <section class="matome-panel-section">
      <div class="matome-panel-section__head"><span class="matome-panel-section__label">Notes</span><button class="matome-panel-section__action">Edit</button></div>
      <div class="matome-panel-section__body"><div class="matome-detail-panel__notes">Discussed Q3 roadmap and owners.</div></div>
    </section>

    <button class="matome-detail-panel__share">#{icon.("share", "")}<span>Share</span></button>
  </div>
  """
end

stage.(css, ~s(<div style="display:flex;gap:var(--matome-space-md);align-items:flex-start">#{panel.(true)}#{panel.(false)}</div>))
```

