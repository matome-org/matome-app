## Contact tile

```elixir
tile = fn name, notes, color ->
  n = if notes == "", do: "", else: ~s(<div class="matome-contact-tile__notes">#{notes}</div>)
  """
  <button class="matome-contact-tile">
    <span class="matome-contact-tile__swatch" style="background:color-mix(in srgb, var(--matome-space-#{color}) 13%, transparent);color:var(--matome-space-#{color})">#{icon.("person", "")}</span>
    <div class="matome-contact-tile__body"><div class="matome-contact-tile__name">#{name}</div>#{n}</div>
    #{icon.("chevron_right", "matome-list-row__chevron")}
  </button>
  """
end

contact_tiles = """
<div style="display:flex;flex-direction:column;gap:var(--matome-space-sm);max-width:360px">
  #{tile.("Ana Ribeiro", "Design lead · Acme", "blue")}
  #{tile.("Leo", "", "green")}
</div>
"""

stage.(css, contact_tiles)
```

