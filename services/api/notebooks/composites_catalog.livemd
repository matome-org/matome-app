## File card — FilesGrid tile (graduated proposal)

```elixir
file_card = fn name, kind, glyph, size, when_txt, matome, space, sync_state, dur ->
  d = if dur == "", do: "", else: ~s(<span class="matome-file-card__duration">#{dur}</span>)
  mchip =
    if matome == "",
      do: ~s(<span class="matome-chip matome-chip--matome matome-chip--empty">#{icon.("inbox", "")}<span class="matome-chip__label">Unfiled</span></span>),
      else: ~s(<span class="matome-chip matome-chip--matome">#{icon.("workspaces", "")}<span class="matome-chip__label">#{matome}</span></span>)
  schip =
    if space == "",
      do: ~s(<span class="matome-chip matome-chip--space matome-chip--empty">#{icon.("inbox", "")}<span class="matome-chip__label">Inbox</span></span>),
      else: ~s(<span class="matome-chip matome-chip--space">#{icon.("folder", "")}<span class="matome-chip__label">#{space}</span></span>)

  """
  <div class="matome-file-card" style="width:200px">
    <div class="matome-file-card__preview matome-file-card__preview--#{kind}">#{icon.(glyph, "")}#{d}</div>
    <div class="matome-file-card__footer">
      <div class="matome-file-card__name">#{name}</div>
      <div class="matome-file-card__sub"><span>#{size}</span><span>·</span><span>#{when_txt}</span></div>
      <div class="matome-file-card__relrow">#{mchip}#{sync.(sync_state)}</div>
      <div class="matome-file-card__relrow">#{schip}<span class="matome-cluster"><span class="matome-avatar matome-avatar--sm">A</span><span class="matome-avatar matome-avatar--sm">K</span></span></div>
    </div>
  </div>
  """
end

grid = """
<div style="display:flex;flex-wrap:wrap;gap:var(--matome-space-md)">
  #{file_card.("standup.m4a", "audio", "mic", "4.2 MB", "Mon", "Client X", "Marketing", "cloud", "03:12")}
  #{file_card.("whiteboard.jpg", "image", "image", "1.1 MB", "Tue", "", "", "on_device", "")}
  #{file_card.("brief.pdf", "document", "description", "820 KB", "Wed", "Ops review", "Ops", "syncing", "")}
</div>
"""

stage.(css, grid)
```
