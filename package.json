{
  "name": "matome-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "node ./scripts/patch-expo-updates.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [],
    "setupFiles": [],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@ui-kitten|@eva-design|@testing-library)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@eva-design/eva": "^2.2.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.90.19",
    "@ui-kitten/components": "^5.3.1",
    "@ui-kitten/eva-icons": "^5.3.1",
    "and": "^0.0.3",
    "axios": "^1.13.2",
    "expo": "^55.0.8",
    "expo-asset": "~55.0.10",
    "expo-audio": "~55.0.9",
    "expo-build-properties": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-image": "~55.0.6",
    "expo-linking": "~55.0.8",
    "expo-localization": "~55.0.9",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.9",
    "expo-splash-screen": "~55.0.12",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.15",
    "expo-web-browser": "~55.0.10",
    "fs-extra": "^11.3.4",
    "i18next": "^25.8.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.6",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^1.1.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.2.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.2",
    "ts-toolbelt": "^9.6.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "babel-jest": "^30.3.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~55.0.0",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.16",
    "typescript": "~5.9.3"
