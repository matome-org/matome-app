{
  "name": "matome-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "turbo run start --filter=matome-app",
    "android": "turbo run android --filter=matome-app",
    "ios": "turbo run ios --filter=matome-app",
    "desktop": "turbo run desktop --filter=@matome/desktop",
    "ai:stub": "node services/ai-stub/src/server.js",
    "generate:api": "turbo run generate:api --filter=@matome/api-client",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  }
}
