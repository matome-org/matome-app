# Non-secret production scaffold for docker-compose.production.yml.
# Copy to .env.production, replace every CHANGE_ME value with a generated secret,
# and keep that file out of version control. Values here are not credentials.

POSTGRES_USER=matome
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_DATABASE_PASSWORD
POSTGRES_DB=matome
DATABASE_URL=postgres://matome:CHANGE_ME_GENERATE_A_DATABASE_PASSWORD@db:5432/matome
DATABASE_SSL=false

SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_MIX_PHX_GEN_SECRET_64_BYTES
GUARDIAN_SECRET_KEY=CHANGE_ME_GENERATE_AN_INDEPENDENT_RANDOM_64_BYTE_SECRET
ADMIN_OTP_PEPPER=CHANGE_ME_GENERATE_AN_INDEPENDENT_RANDOM_32_BYTE_SECRET

# SMTP is shown because production rejects the local mail adapter.
MAILER_ADAPTER=smtp
SMTP_RELAY=CHANGE_ME_SMTP_HOST
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_PORT=587
SMTP_SSL=true

PHX_HOST=api.example.com
CORE_PORT=7001
WEB_PORT=80
CORS_ORIGINS=https://app.example.com
API_BASE_URL=https://api.example.com

# These must be different random values, each at least 32 bytes.
AI_ENGINE_DISPATCH_TOKEN=CHANGE_ME_GENERATE_RANDOM_DISPATCH_TOKEN_AT_LEAST_32_BYTES
AI_ENGINE_CALLBACK_SIGNING_SECRET=CHANGE_ME_GENERATE_DIFFERENT_CALLBACK_SECRET_AT_LEAST_32_BYTES
AI_ENGINE_CALLBACK_BASE_URL=https://api.example.com
WHISPER_BACKEND=openai
WHISPER_MODEL=base
# Fixed by Compose and backed by the matome_ai_core_jobs named volume:
# AI_JOB_DATA_PATH=/var/lib/matome-ai-core/jobs.sqlite3

STORAGE_S3_ACCESS_KEY_ID=CHANGE_ME_GENERATE_MINIO_ACCESS_KEY
STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME_GENERATE_MINIO_SECRET_KEY
STORAGE_S3_REGION=local
STORAGE_MEDIA_BUCKET=media
MINIO_PORT=9000
# Browser-public HTTPS object URL; never use http://minio:9000 here.
STORAGE_S3_ENDPOINT=https://media.example.com
