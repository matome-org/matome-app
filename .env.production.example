# Production scaffold for docker-compose.production.yml. Copy to .env.production
# (gitignored) and replace every CHANGE_ME value.
#
# `./.scripts/gen-localserver-env.sh --stack=production` fills the secrets and
# copies the rest of this file, leaving only the values a human has to decide:
# the domain and the SMTP relay.

# Public domain of the deployment. Compose derives the service URLs from it as
# api.<domain>, app.<domain> and media.<domain>, so point those A records at
# the host and attach the matching domains in Dokploy.
BASE_DOMAIN=CHANGE_ME_EXAMPLE_COM

# Secrets. Generate each with: openssl rand -hex 32
# SECRET_KEY_BASE needs 64 bytes: openssl rand -hex 64
# AI_ENGINE_DISPATCH_TOKEN and AI_ENGINE_CALLBACK_SIGNING_SECRET must differ.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_DATABASE_PASSWORD
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_MIX_PHX_GEN_SECRET_64_BYTES
GUARDIAN_SECRET_KEY=CHANGE_ME_GENERATE_AN_INDEPENDENT_RANDOM_64_BYTE_SECRET
ADMIN_OTP_PEPPER=CHANGE_ME_GENERATE_AN_INDEPENDENT_RANDOM_32_BYTE_SECRET
STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME_GENERATE_MINIO_SECRET_KEY
AI_ENGINE_DISPATCH_TOKEN=CHANGE_ME_GENERATE_RANDOM_DISPATCH_TOKEN_AT_LEAST_32_BYTES
AI_ENGINE_CALLBACK_SIGNING_SECRET=CHANGE_ME_GENERATE_DIFFERENT_CALLBACK_SECRET_AT_LEAST_32_BYTES

# SMTP is listed because production rejects the local mail adapter.
MAILER_ADAPTER=smtp
SMTP_RELAY=CHANGE_ME_SMTP_HOST
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_PORT=587
SMTP_SSL=true

# Ports published on the host. Traefik owns 80/443 and routes each domain to
# these, so none of them may be 80.
WEB_PORT=8080
CORE_PORT=7001
MINIO_PORT=9000

WHISPER_BACKEND=openai
WHISPER_MODEL=base

# Optional overrides. The Compose defaults are shown; uncomment to change.
# POSTGRES_USER=matome
# POSTGRES_DB=matome
# DATABASE_SSL=false
# STORAGE_S3_ACCESS_KEY_ID=matome
# STORAGE_S3_REGION=local
# STORAGE_MEDIA_BUCKET=media
# ADMIN_PANEL_ENABLED=false
# ADMIN_EMAIL_ALLOWLIST=
# Fixed by Compose, backed by the matome_ai_core_jobs volume:
# AI_JOB_DATA_PATH=/var/lib/matome-ai-core/jobs.sqlite3

# Escape hatches. Derived from BASE_DOMAIN and POSTGRES_* when unset.
# PHX_HOST=api.example.com
# API_BASE_URL=https://api.example.com
# CORS_ORIGINS=https://app.example.com
# STORAGE_S3_ENDPOINT=https://media.example.com
# AI_ENGINE_CALLBACK_BASE_URL=https://api.example.com
# DATABASE_URL=postgres://matome:PASSWORD@db:5432/matome
