{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matome Desktop",
  "version": "0.1.0",
  "identifier": "com.matome.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Matome Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4000 http://localhost:4000 http://127.0.0.1:54321 http://localhost:54321; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "targets": "all"
  }
}
