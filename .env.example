# Local docker-compose config (Core API + Flutter Web + Postgres + MinIO + AI stub).
# Copy to `.env` (git-ignored) — `docker compose up` reads `.env` automatically.
# All values below are DEV-safe defaults; change secrets for anything non-local.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DB_PORT=7020

# ── Core API (Phoenix, dev mode) ──────────────────────────────────────────
CORE_PORT=7001
DATABASE_URL=postgres://postgres:postgres@db:5432/matome_api_dev
GUARDIAN_SECRET_KEY=dev-guardian-secret-change-before-prod
AI_ENGINE_DISPATCH_TOKEN=dev-ai-dispatch-token
AI_ENGINE_CALLBACK_SIGNING_SECRET=dev-ai-callback-signing-secret
AI_STUB_PORT=7002

# ── Flutter Web ───────────────────────────────────────────────────────────
WEB_PORT=7000
# Baked at BUILD time (compile-time dart-define). Must be the core URL the
# BROWSER uses — the host-published address, NOT the compose service name.
API_BASE_URL=http://localhost:7001
CORS_ORIGINS=http://localhost:7000,http://127.0.0.1:7000

# ── Object storage (MinIO, S3-compatible) ─────────────────────────────────
MINIO_PORT=7021
MINIO_CONSOLE_PORT=7022
STORAGE_MEDIA_BUCKET=media
STORAGE_S3_REGION=local
STORAGE_S3_ACCESS_KEY_ID=matome
STORAGE_S3_SECRET_ACCESS_KEY=matome-dev-secret
# Endpoint baked into presigned URLs → MUST be browser-reachable (host port).
# Core presigns OFFLINE (no connection), so this host only needs to resolve
# from the browser. localhost:${MINIO_PORT} does exactly that.
STORAGE_S3_ENDPOINT=http://localhost:7021
