# Matome local development port contract.
# Keep every host-visible project port in the 7000+ range to avoid collisions
# with other projects.

# App/runtime local
MATOME_FLUTTER_WEB_PORT=7000
MATOME_CORE_PORT=7001
MATOME_AI_STUB_PORT=7002
# 7003 retired: the Core design-system catalog is now phoenix_storybook, served
# on the Core API at $MATOME_CORE_PORT/storybook (no separate port/process).
MATOME_STORYBOOK_PORT=7004

# Native data plane (mise run up / backend) — Postgres + MinIO
MATOME_PG_PORT=7020
MATOME_COMPOSE_DB_PORT=7020
MATOME_MINIO_PORT=7021
MATOME_MINIO_CONSOLE_PORT=7022
