{
  "openapi": "3.1.0",
  "info": {
    "title": "Matome Core API",
    "version": "0.1.0",
    "description": "Core REST API for Matome authentication, recordings, spaces, and recording media URLs."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthShow",
        "tags": ["health"],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "authRegister",
        "x-client-method": "register",
        "tags": ["auth"],
        "summary": "Register with email and password",
        "security": [],
        "requestBody": { "$ref": "#/components/requestBodies/AuthCredentials" },
        "responses": {
          "201": { "$ref": "#/components/responses/AuthResponse" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "authLogin",
        "x-client-method": "login",
        "tags": ["auth"],
        "summary": "Login with email and password",
        "security": [],
        "requestBody": { "$ref": "#/components/requestBodies/AuthCredentials" },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "authRefresh",
        "x-client-method": "refresh",
        "tags": ["auth"],
        "summary": "Rotate a refresh token and issue new tokens",
        "security": [],
        "requestBody": { "$ref": "#/components/requestBodies/RefreshToken" },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "x-client-method": "logout",
        "tags": ["auth"],
        "summary": "Revoke a refresh token",
        "security": [],
        "requestBody": { "$ref": "#/components/requestBodies/RefreshToken" },
        "responses": { "204": { "description": "Logged out" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "authMe",
        "x-client-method": "me",
        "tags": ["auth"],
        "summary": "Return the authenticated user",
        "responses": {
          "200": { "$ref": "#/components/responses/MeResponse" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/spaces": {
      "get": {
        "operationId": "spacesList",
        "x-client-method": "listSpaces",
        "tags": ["spaces"],
        "summary": "List authenticated user's spaces",
        "parameters": [{ "$ref": "#/components/parameters/SearchQuery" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SpacesResponse" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "spacesCreate",
        "x-client-method": "createSpace",
        "tags": ["spaces"],
        "summary": "Create a space for the authenticated user",
        "requestBody": { "$ref": "#/components/requestBodies/SpaceInput" },
        "responses": {
          "201": { "$ref": "#/components/responses/SpaceResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/spaces/search": {
      "get": {
        "operationId": "spacesSearch",
        "x-client-method": "searchSpaces",
        "tags": ["spaces"],
        "summary": "Search authenticated user's spaces by name",
        "parameters": [{ "$ref": "#/components/parameters/SearchQuery" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SpacesResponse" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/spaces/{id}": {
      "get": {
        "operationId": "spacesShow",
        "x-client-method": "getSpace",
        "tags": ["spaces"],
        "summary": "Get one authenticated-user-owned space",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SpaceResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "spacesUpdate",
        "x-client-method": "updateSpace",
        "tags": ["spaces"],
        "summary": "Update one authenticated-user-owned space",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/SpaceInput" },
        "responses": {
          "200": { "$ref": "#/components/responses/SpaceResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "patch": {
        "operationId": "spacesPatch",
        "x-client-method": "patchSpace",
        "tags": ["spaces"],
        "summary": "Partially update one authenticated-user-owned space",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/SpacePatch" },
        "responses": {
          "200": { "$ref": "#/components/responses/SpaceResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "operationId": "spacesDelete",
        "x-client-method": "deleteSpace",
        "tags": ["spaces"],
        "summary": "Delete one authenticated-user-owned space",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/recordings": {
      "get": {
        "operationId": "recordingsList",
        "x-client-method": "listRecordings",
        "tags": ["recordings"],
        "summary": "List authenticated user's recordings",
        "parameters": [{ "$ref": "#/components/parameters/SearchQuery" }],
        "responses": {
          "200": { "$ref": "#/components/responses/RecordingsResponse" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "recordingsCreate",
        "x-client-method": "createRecording",
        "tags": ["recordings"],
        "summary": "Create a recording and issue a presigned upload URL",
        "requestBody": { "$ref": "#/components/requestBodies/RecordingInput" },
        "responses": {
          "201": { "$ref": "#/components/responses/RecordingCreateResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/recordings/search": {
      "get": {
        "operationId": "recordingsSearch",
        "x-client-method": "searchRecordings",
        "tags": ["recordings"],
        "summary": "Search authenticated user's recordings by title, summary, or transcript",
        "parameters": [{ "$ref": "#/components/parameters/SearchQuery" }],
        "responses": {
          "200": { "$ref": "#/components/responses/RecordingsResponse" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/recordings/{id}": {
      "get": {
        "operationId": "recordingsShow",
        "x-client-method": "getRecording",
        "tags": ["recordings"],
        "summary": "Get one authenticated-user-owned recording",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/RecordingResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "recordingsUpdate",
        "x-client-method": "updateRecording",
        "tags": ["recordings"],
        "summary": "Update one authenticated-user-owned recording",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/RecordingInput" },
        "responses": {
          "200": { "$ref": "#/components/responses/RecordingResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "patch": {
        "operationId": "recordingsPatch",
        "x-client-method": "patchRecording",
        "tags": ["recordings"],
        "summary": "Partially update one authenticated-user-owned recording",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/RecordingPatch" },
        "responses": {
          "200": { "$ref": "#/components/responses/RecordingResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "operationId": "recordingsDelete",
        "x-client-method": "deleteRecording",
        "tags": ["recordings"],
        "summary": "Delete one authenticated-user-owned recording",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/recordings/{id}/download-url": {
      "get": {
        "operationId": "recordingsDownloadUrl",
        "x-client-method": "getRecordingDownloadUrl",
        "tags": ["recordings", "storage"],
        "summary": "Issue a short-lived presigned GET URL for one owned recording's media",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/DownloadResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/recordings/{id}/process": {
      "post": {
        "operationId": "recordingsProcess",
        "x-client-method": "processRecording",
        "tags": ["recordings"],
        "summary": "Queue internal AI processing after media upload completes",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "202": { "$ref": "#/components/responses/RecordingProcessResponse" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
      "SearchQuery": { "name": "q", "in": "query", "required": false, "schema": { "type": "string" } }
    },
    "requestBodies": {
      "AuthCredentials": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthCredentials" } } } },
      "RefreshToken": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } } } },
      "SpaceInput": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpaceInput" } } } },
      "SpacePatch": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpacePatch" } } } },
      "RecordingInput": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordingInput" } } } },
      "RecordingPatch": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordingPatch" } } } }
    },
    "responses": {
      "AuthResponse": { "description": "Auth tokens", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
      "MeResponse": { "description": "Current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } } },
      "SpaceResponse": { "description": "Space", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpaceResponse" } } } },
      "SpacesResponse": { "description": "Spaces", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpacesResponse" } } } },
      "RecordingResponse": { "description": "Recording", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordingResponse" } } } },
      "RecordingCreateResponse": { "description": "Recording with upload URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordingCreateResponse" } } } },
      "RecordingProcessResponse": { "description": "Recording processing queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordingProcessResponse" } } } },
      "RecordingsResponse": { "description": "Recordings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordingsResponse" } } } },
      "DownloadResponse": { "description": "Presigned download URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DownloadResponse" } } } },
      "Error": { "description": "Error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "ValidationError": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
    },
    "schemas": {
      "HealthResponse": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string" } } },
      "AuthCredentials": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 1 } } },
      "RefreshTokenRequest": { "type": "object", "required": ["refresh_token"], "properties": { "refresh_token": { "type": "string" } } },
      "User": { "type": "object", "required": ["id", "email"], "properties": { "id": { "type": "integer" }, "email": { "type": "string", "format": "email" } } },
      "AuthResponse": { "type": "object", "required": ["user", "access_token", "refresh_token", "token_type"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "access_token": { "type": "string" }, "refresh_token": { "type": "string" }, "token_type": { "type": "string", "enum": ["Bearer"] } } },
      "MeResponse": { "type": "object", "required": ["user"], "properties": { "user": { "$ref": "#/components/schemas/User" } } },
      "Space": { "type": "object", "required": ["id", "owner_id", "name", "inserted_at", "updated_at"], "properties": { "id": { "type": "integer" }, "owner_id": { "type": "integer" }, "name": { "type": "string" }, "description": { "type": ["string", "null"] }, "inserted_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" } } },
      "SpaceInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "description": { "type": "string" } } },
      "SpacePatch": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" } } },
      "SpaceResponse": { "type": "object", "required": ["space"], "properties": { "space": { "$ref": "#/components/schemas/Space" } } },
      "SpacesResponse": { "type": "object", "required": ["workspaces"], "properties": { "workspaces": { "type": "array", "items": { "$ref": "#/components/schemas/Space" } } } },
      "RecordingStatus": { "type": "string", "enum": ["pending", "processing", "done", "failed"] },
      "Recording": { "type": "object", "required": ["id", "owner_id", "title", "storage_key", "status", "inserted_at", "updated_at"], "properties": { "id": { "type": "integer" }, "owner_id": { "type": "integer" }, "title": { "type": "string" }, "summary": { "type": ["string", "null"] }, "transcript": { "type": ["string", "null"] }, "media_type": { "type": ["string", "null"] }, "storage_key": { "type": "string" }, "status": { "$ref": "#/components/schemas/RecordingStatus" }, "error_reason": { "type": ["string", "null"] }, "duration": { "type": ["integer", "null"] }, "badge": { "type": ["string", "null"] }, "workspace_id": { "type": ["integer", "null"] }, "inserted_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" } } },
      "RecordingInput": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" }, "summary": { "type": "string" }, "transcript": { "type": "string" }, "media_type": { "type": "string" }, "status": { "$ref": "#/components/schemas/RecordingStatus" }, "error_reason": { "type": "string" }, "duration": { "type": "integer" }, "badge": { "type": "string" }, "workspace_id": { "type": "integer" } } },
      "RecordingPatch": { "type": "object", "properties": { "title": { "type": "string" }, "summary": { "type": "string" }, "transcript": { "type": "string" }, "media_type": { "type": "string" }, "status": { "$ref": "#/components/schemas/RecordingStatus" }, "error_reason": { "type": "string" }, "duration": { "type": "integer" }, "badge": { "type": "string" }, "workspace_id": { "type": "integer" } } },
      "PresignedUrl": { "type": "object", "required": ["url", "method", "expires_in"], "properties": { "url": { "type": "string", "format": "uri" }, "method": { "type": "string" }, "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "expires_in": { "type": "integer" } } },
      "RecordingResponse": { "type": "object", "required": ["recording"], "properties": { "recording": { "$ref": "#/components/schemas/Recording" } } },
      "RecordingCreateResponse": { "type": "object", "required": ["recording", "upload"], "properties": { "recording": { "$ref": "#/components/schemas/Recording" }, "upload": { "$ref": "#/components/schemas/PresignedUrl" } } },
      "RecordingProcessResponse": { "type": "object", "required": ["recording", "processing"], "properties": { "recording": { "$ref": "#/components/schemas/Recording" }, "processing": { "type": "object", "required": ["queued"], "properties": { "queued": { "type": "boolean" } } } } },
      "RecordingsResponse": { "type": "object", "required": ["recordings"], "properties": { "recordings": { "type": "array", "items": { "$ref": "#/components/schemas/Recording" } } } },
      "DownloadResponse": { "type": "object", "required": ["download"], "properties": { "download": { "$ref": "#/components/schemas/PresignedUrl" } } },
      "ErrorResponse": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "ValidationErrorResponse": { "type": "object", "required": ["errors"], "properties": { "errors": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } } } }
    }
  }
}
