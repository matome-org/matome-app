# Dokploy environment scaffold for docker-compose.localserver.yml.
# Copy these keys into Dokploy and replace every CHANGE_ME value. Do not commit
# the resulting secrets.
#
# `mise run localserver:env` fills HOST_IP and every secret below into a
# gitignored .env.localserver, so this file is only needed as a reference for
# the optional settings.
#
# Only two things need a human decision: HOST_IP and the secrets. Every
# browser-reachable URL (API_BASE_URL, CORS_ORIGINS, STORAGE_S3_ENDPOINT) and
# DATABASE_URL are derived from HOST_IP, the ports, and the POSTGRES_* pair.
# Set them explicitly only when the derived shape does not fit.

# LAN or WSL address of this server. Must be reachable by browsers and by the
# ai-core container for presigned media downloads.
HOST_IP=CHANGE_ME_LAN_OR_WSL_IP

# Secrets. Generate each with: openssl rand -hex 32
# AI_ENGINE_DISPATCH_TOKEN and AI_ENGINE_CALLBACK_SIGNING_SECRET must differ.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_DATABASE_PASSWORD
GUARDIAN_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
ADMIN_OTP_PEPPER=CHANGE_ME_GENERATE_RANDOM_32_BYTE_SECRET
STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME_GENERATE_MINIO_SECRET
AI_ENGINE_DISPATCH_TOKEN=CHANGE_ME_GENERATE_RANDOM_DISPATCH_TOKEN
AI_ENGINE_CALLBACK_SIGNING_SECRET=CHANGE_ME_GENERATE_DIFFERENT_CALLBACK_SECRET

# Ports published on the host. These match the Compose defaults.
WEB_PORT=7000
CORE_PORT=7001
MINIO_PORT=7021
MINIO_CONSOLE_PORT=7022

ADMIN_EMAIL_ALLOWLIST=dev@matome.test

# Real local transcription runs through the pre-built whisper.cpp CPU backend.
# The model is downloaded lazily and retained in a dedicated model volume.
WHISPER_BACKEND=whispercpp
WHISPER_MODEL=base

# LM Studio runs on the same server. host.docker.internal is mapped to the
# Docker host by the Compose service. These settings prepare the existing
# OpenAI-compatible client; chat models are not yet registered for app jobs.
OPENAI_BASE_URL=http://host.docker.internal:1234
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=CHANGE_ME_SELECT_LOADED_LM_STUDIO_MODEL
OPENAI_TIMEOUT_SECONDS=60

# Optional overrides. The Compose defaults are shown; uncomment to change.
# POSTGRES_USER=matome
# POSTGRES_DB=matome
# DATABASE_SSL=false
# STORAGE_S3_ACCESS_KEY_ID=matome
# STORAGE_S3_REGION=local
# STORAGE_MEDIA_BUCKET=media

# Escape hatches. Derived from HOST_IP, the ports and POSTGRES_* when unset.
# API_BASE_URL=http://HOST_IP:7001
# CORS_ORIGINS=http://HOST_IP:7000
# STORAGE_S3_ENDPOINT=http://HOST_IP:7021
# DATABASE_URL=postgres://matome:PASSWORD@db:5432/matome
