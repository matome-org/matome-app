# How .scripts/push-dokploy-env.sh talks to the Dokploy instance. This is NOT
# app config — the app environment lives in .env.localserver.
#
# Copy to .env.dokploy.local (gitignored via .env*.local) and fill it in. The
# token is an admin credential for the whole Dokploy instance: anyone holding
# it controls every deploy on it.

# Base URL of the Dokploy dashboard, no trailing slash.
DOKPLOY_URL=http://CHANGE_ME_DOKPLOY_HOST:3000

# API token from the Dokploy dashboard: /settings/profile -> API/CLI section.
# Sent as the x-api-key header.
DOKPLOY_TOKEN=CHANGE_ME_DOKPLOY_API_TOKEN

# Id of the compose service running docker-compose.localserver.yml. Read it
# from that service's dashboard URL, or list every service with:
#   curl -H "x-api-key: $DOKPLOY_TOKEN" "$DOKPLOY_URL/api/project.all" |
#     jq -r '.[].environments[].compose[] | "\(.name) \(.composeId)"'
DOKPLOY_COMPOSE_ID=CHANGE_ME_COMPOSE_ID
