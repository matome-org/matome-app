{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matome.app/contracts/v1/device-queue-snapshot.schema.json",
  "title": "Matome device queue snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "sequence", "applied_config_revision", "snapshot"],
  "properties": {
    "contract_version": {"const": "1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "applied_config_revision": {"type": "integer", "minimum": 0},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "stages", "errors", "oldest_age_seconds", "progress", "items"],
      "properties": {
        "counts": {"$ref": "#/$defs/state_counts"},
        "stages": {"$ref": "#/$defs/stage_counts"},
        "errors": {"$ref": "#/$defs/error_counts"},
        "oldest_age_seconds": {"$ref": "#/$defs/age"},
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["average", "minimum"],
          "properties": {
            "average": {"$ref": "#/$defs/progress_value"},
            "minimum": {"$ref": "#/$defs/progress_value"}
          }
        },
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}},
        "local_spaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_count", "oldest_age_seconds"],
          "properties": {
            "work_count": {"$ref": "#/$defs/count"},
            "oldest_age_seconds": {"$ref": "#/$defs/age"}
          }
        }
      }
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "age": {"type": ["integer", "null"], "minimum": 0, "maximum": 315360000},
    "progress_value": {"type": "number", "minimum": 0, "maximum": 1},
    "state": {"enum": ["queued", "running", "retry", "blocked", "dead"]},
    "stage": {"enum": ["reconcile_parent", "create_remote", "hash_file", "request_upload", "upload", "upload_single", "upload_parts", "complete_upload", "enqueue_processing", "processing_accepted", "upload_only_complete"]},
    "media_type": {"enum": ["audio", "image", "document", "video"]},
    "error_code": {"enum": ["transport", "timeout", "rate_limited", "server_unavailable", "unauthorized", "content_rejected", "invalid_local_data", "unexpected"]},
    "state_counts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/state"},
      "additionalProperties": {"$ref": "#/$defs/count"},
      "maxProperties": 5
    },
    "stage_counts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/stage"},
      "additionalProperties": {"$ref": "#/$defs/count"},
      "maxProperties": 11
    },
    "error_counts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/error_code"},
      "additionalProperties": {"$ref": "#/$defs/count"},
      "maxProperties": 8
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_item_id", "state", "stage", "media_type", "age_seconds", "progress", "error_code"],
      "properties": {
        "core_item_id": {"type": "integer", "minimum": 1},
        "state": {"$ref": "#/$defs/state"},
        "stage": {"$ref": "#/$defs/stage"},
        "media_type": {"$ref": "#/$defs/media_type"},
        "age_seconds": {"$ref": "#/$defs/age"},
        "progress": {"$ref": "#/$defs/progress_value"},
        "error_code": {"anyOf": [{"$ref": "#/$defs/error_code"}, {"type": "null"}]}
      }
    }
  }
}
