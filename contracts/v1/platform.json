  },
  "system_config": {
    "schema": "system-config.schema.json",
    "singleton_key": "global",
    "non_secret": true,
    "desired_semantics": "Admin writes policy intent at a new monotonic revision; this does not assert that an offline device applied it.",
    "applied_semantics": {
      "core": "Core reports applied only after the config transaction and mandatory audit event commit together.",
      "device": "Each device reports its own last applied revision and rejected keys in a sanitized snapshot.",
      "offline": "Keep the last applied revision and report it as stale; never copy desired into applied."
    },
    "stale_write_rule": "Reject a desired update whose base_revision does not equal current revision.",
    "secret_rule": "Tokens, credentials, and signing material remain in runtime environment or a secret store."
  },
  "data_model_decisions": {
    "retain": ["items", "file_blobs", "text_contents"],
    "relationship": "Each item has exactly one 1:1 payload row: file_blob or text_content.",
    "avoid_domain_tables": ["processing_attempts", "derivations", "upload_sessions"],
    "attempt_storage": "Executor metadata stays in Drift work_queue or Oban; current Core run stays on items.",
    "upload_storage": "One bounded active multipart context stays on file_blobs.",
    "migration_policy": "clean_schema_reset",
    "reason": "no_users_and_no_deployment"
  }
}
