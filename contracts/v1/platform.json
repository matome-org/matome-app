{
  "name": "matome-local-first-platform",
  "version": "1.0.0",
  "wire_version": "1",
  "compatibility": "A wire-incompatible change requires a new contracts/vN directory.",
  "work": {
    "states": [
      "local_saved",
      "work_queued",
      "parent_item_reconciled",
      "uploading",
      "uploaded",
      "processing_queued",
      "processing",
      "succeeded",
      "failed"
    ],
    "legal_transitions": {
      "local_saved": ["work_queued"],
      "work_queued": ["parent_item_reconciled", "failed"],
      "parent_item_reconciled": ["uploading", "processing_queued", "succeeded", "failed"],
      "uploading": ["uploaded", "work_queued", "failed"],
      "uploaded": ["processing_queued", "succeeded"],
      "processing_queued": ["processing", "failed"],
      "processing": ["succeeded", "failed"],
      "succeeded": [],
      "failed": []
    },
    "upload_states": ["not_required", "pending", "uploading", "uploaded", "failed", "aborted"],
    "processing_states": ["not_requested", "queued", "processing", "succeeded", "failed"],
    "authorities": {
      "drift": [
        "local item and parent identity before reconciliation",
        "user-authored content and notes",
        "device work queue, attempts, leases, and next-run time",
        "local file durability"
      ],
      "core": [
        "remote item and parent identity",
        "current input revision and processing run",
        "verified upload state",
        "accepted machine outputs and sanitized error codes",
        "global desired system configuration"
      ],
      "oban": [
        "physical execution and retry scheduling for Core work only",
        "never product lifecycle state or user-content authority"
      ]
    },
    "dedupe_keys": {
      "device_work": ["item_local_id", "operation", "input_revision"],
      "core_item_create": ["owner_id", "device_id", "item_local_id", "input_revision"],
      "upload": ["item_id", "input_revision", "upload_generation"],
      "processing": ["item_id", "input_revision", "run_id"]
    },
    "lease": {
      "owner_field": "lease_owner",
      "expiry_field": "lease_expires_at",
      "acquire_rule": "queued_or_expired_and_next_run_at_due",
      "renew_rule": "same_owner_and_run_is_current",
      "expiry_action": "requeue_if_run_is_current"
    },
    "retry": {
      "strategy": "exponential_full_jitter",
      "attempt_field": "attempt",
      "delay_formula": "random(0,min(max_delay,base_delay*2^(attempt-1)))",
      "retryable_classes": ["transport", "timeout", "rate_limited", "server_unavailable"],
      "terminal_classes": ["validation", "unauthorized", "unsupported", "content_rejected"],
      "manual_retry_creates_new_run": true,
      "manual_retry_resets_attempt": true
    },
    "stale_run": {
      "accept_when": "run_id_and_input_revision_match_current",
      "otherwise": "acknowledge_without_mutation",
      "duplicate_terminal_callback": "idempotent_noop"
    },
    "upload_only_completion": {
      "upload_state": "uploaded",
      "processing_state": "not_requested",
      "work_state": "succeeded"
    },
    "device_upload_stages": [
      "reconcile_parent",
      "hash_file",
      "create_remote",
      "request_upload",
      "upload_single_or_missing_parts",
      "complete_upload",
      "enqueue_processing_or_upload_only_complete"
    ],
    "capture_rule": "The canonical Item and work row are created only after capture finalization; recording and paused capture states perform no upload or Core request.",
    "upload_progress_rule": "Persist progress only from Core/provider-accepted part byte sizes; never report uploaded before Core verifies exact size and SHA-256.",
    "processing_policy": "Enqueue only when the input kind is enabled by the client capability policy; otherwise complete as upload-only without awaiting AI.",
    "parent_rule": "Reconcile the parent before the child; parent work is queued automatically and a missing parent Core id is never a silent terminal skip."
  },
  "upload": {
    "contract_version": "1",
    "modes": ["single", "multipart"],
    "operations": ["request", "inspect", "presign_part", "complete", "abort"],
    "paths": {
      "request": "POST /api/v1/items/{item_id}/uploads",
      "inspect": "GET /api/v1/uploads/{upload_id}",
      "presign_part": "POST /api/v1/uploads/{upload_id}/parts/{part_number}/presign",
      "complete": "POST /api/v1/uploads/{upload_id}/complete",
      "abort": "POST /api/v1/uploads/{upload_id}/abort"
    },
    "auth": "owner_bearer_token",
    "mode_selection": "Core selects single or multipart from desired system_config and byte_size when mode is auto.",
    "generation_rule": "Only the active upload_generation may complete or abort; stale generations are idempotent noops.",
    "verification": "Complete succeeds only after Core verifies object size and SHA-256; an ETag alone is insufficient.",
    "multipart": {
      "part_numbers": "contiguous_1_based",
      "part_retry": "same_upload_id_generation_and_part_number",
      "resume": "request and inspect return provider-accepted parts plus only the missing part numbers for the active generation",
      "active_context": "one bounded JSONB context on file_blobs; no upload_sessions table",
      "device_persistence": "Drift file_blobs.multipart_context stores only upload id, generation, mode, geometry, ETags, checksums, and accepted byte sizes; signed URLs and headers are memory-only.",
      "expiry": "presign expiry retains the provider upload for resume; context expiry aborts provider state before clearing Core context"
    },
    "limits_source": "MatomeApi.Storage.UploadPolicy runtime configuration",
    "limits": {
      "single_max_bytes": 26214400,
      "multipart_part_bytes": 16777216,
      "max_bytes": 2147483648,
      "provider_max_bytes": 5497558138880,
      "media_max_bytes": {
        "audio": 2147483648,
        "image": 52428800,
        "document": 524288000,
        "video": 2147483648
      }
    }
  },
  "ai": {
    "contract_version": "1",
    "paths": {
      "capabilities": "GET /v1/capabilities",
      "jobs": "POST /v1/jobs",
      "callback": "job.callback.url"
    },
    "auth": "bearer_service_token",
    "token_source": "runtime_secret_only",
    "accepted_response": "202 with contract_version, job_id, run_id, and accepted=true",
    "input_kinds": ["audio", "image", "document", "text"],
    "callback_statuses": ["done", "failed"],
    "terminal_callback_count": 1,
    "idempotency_key": ["job_id", "run_id", "input_revision"],
    "limits_rule": "Core uses the lower of system_config policy and the advertised capability limit.",
    "metadata_allowlist": ["locale"],
    "automatic_text_rule": "Only text item body is sent automatically; file notes and Matome notes are excluded.",
    "typed_outputs": {
      "audio": ["transcript", "summary", "title"],
      "image": ["ocr_text", "description", "summary", "title"],
      "document": ["extracted_text", "summary", "title"],
      "text": ["summary", "title"]
    },
    "output_value_types": {
      "transcript": "text_with_optional_language_and_duration_ms",
      "ocr_text": "text_with_optional_language",
      "description": "text",
      "extracted_text": "text_with_optional_language",
      "summary": "markdown",
      "title": "text"
    },
    "failure": {
      "required": ["code", "message", "retryable"],
      "message_rule": "sanitized_no_secrets_or_input_content"
    }
  },
  "events": {
    "contract_version": "1",
    "classes": ["security", "operational", "product"],
    "envelope_required": [
      "event_id",
      "catalog_key",
      "event_name",
      "event_version",
      "event_class",
      "occurred_at",
      "source",
      "correlation_id",
      "payload"
    ],
    "max_payload_bytes": 4096,
    "reject_unknown_payload_keys": true,
    "product_ingest": {
      "path": "POST /api/events",
      "auth": "owner_bearer_token",
      "eligible_class": "optional_product_only",
      "identity_rule": "Core derives actor, owner, and session device; client identity fields are ignored.",
      "consent_rule": "The client sends no request without user opt-in; opted_in=false records nothing. Catalog enablement cannot grant consent."
    },
    "prohibited_payload_keys": [
      "access_token",
      "refresh_token",
      "authorization",
      "password",
      "secret",
      "body",
      "notes",
      "transcript",
      "summary",
      "storage_url",
      "local_space_id"
    ],
    "local_space_egress": "No local Space id or content may leave a device; only opt-in aggregate product events are eligible.",
    "catalog": [
      {
        "catalog_key": "security.event_catalog.changed.v1",
